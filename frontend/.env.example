# ============================================================
# AgriShield Frontend — Environment Variables
# ============================================================
# Copy this file to .env.local for local development.
# Set VITE_API_BASE_URL in the Vercel dashboard for production.
# ============================================================

# Backend API base URL (no trailing slash)
# Local:
VITE_API_BASE_URL=http://localhost:8000/api

# Production (replace with your actual Render service URL):
# VITE_API_BASE_URL=https://agrishield-api.onrender.com/api
