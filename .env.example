# ============================================================
# AgriShield — Environment Variables Reference
# ============================================================
# Copy this file to .env for local development.
# NEVER commit .env to git (it is already in .gitignore).
# Set these in the Render dashboard for production.
# ============================================================

# ── Database ──────────────────────────────────────────────────────────────────
# Local (SQLite — default, no setup needed):
# DATABASE_URL=sqlite:///./postharvest.db
#
# Production (Supabase PostgreSQL — required for Render):
DATABASE_URL=postgresql://postgres:<password>@db.<project-ref>.supabase.co:5432/postgres

# ── JWT Secret ────────────────────────────────────────────────────────────────
# Generate with: python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=CHANGE_ME_TO_A_LONG_RANDOM_STRING

# ── CORS ──────────────────────────────────────────────────────────────────────
# Comma-separated list of allowed frontend origins.
# Local: http://localhost:5173
# Production: https://<your-app>.vercel.app
ALLOWED_ORIGINS=http://localhost:5173,http://localhost:5174

# ── External API Keys ─────────────────────────────────────────────────────────
# OpenWeatherMap — https://openweathermap.org/api
WEATHER_API_KEY=your_openweathermap_api_key_here

# Google Gemini — https://aistudio.google.com/app/apikey
GEMINI_API_KEY=your_gemini_api_key_here

# Google API (Maps / other services)
GOOGLE_API_KEY=your_google_api_key_here

# Government Agrimarket API (optional)
MARKET_API_KEY=your_market_api_key_here

# ── Frontend (Vite) ───────────────────────────────────────────────────────────
# Put this in frontend/.env or frontend/.env.local
# Local development:
# VITE_API_BASE_URL=http://localhost:8000/api
#
# Production (set in Vercel dashboard under Environment Variables):
# VITE_API_BASE_URL=https://<your-render-service>.onrender.com/api
